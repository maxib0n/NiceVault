#!/usr/bin/env bash
args=()
skip=0
for a in "$@"; do
  if [ $skip = 1 ]; then skip=0; continue; fi
  case "$a" in
    -arch|-isysroot|-target) skip=1 ;;
    --target=*|-mios-version-min=*|-miphoneos-version-min=*|-mios-simulator-version-min=*|-miphonesimulator-version-min=*) ;;
    *) args+=("$a") ;;
  esac
done
exec "${NV_IOS_CLANG:-clang}" -target "${NV_IOS_TRIPLE:?}" -isysroot "${SDKROOT:?}" \
  -fuse-ld=lld -Wno-unused-command-line-argument "${args[@]}"
