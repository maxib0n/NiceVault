{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events/webview APIs and native open/save dialogs.",
  "windows": ["main", "unlock"],
  "permissions": [
    "core:default",
    "core:webview:default",
    "core:window:allow-set-fullscreen",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
