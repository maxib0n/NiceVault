{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NiceVault",
  "version": "0.3.1",
  "identifier": "app.nicevault.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "NiceVault",
        "visible": false,
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "backgroundColor": "#1b1a19"
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; img-src 'self' data: blob: nvault: http://nvault.localhost; media-src 'self' blob: nvault: http://nvault.localhost http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost nvault: http://nvault.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MzNDNzUzNzA2RTBBRjMKUldUekNtNXdVOGN6TlZLRzVPYkd6UHlWOWRTVmZVTENYTXRKc1Y0UUcvamdTSno4bHUxWkRnZEsK",
      "endpoints": [
        "https://github.com/maxib0n/NiceVault/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
