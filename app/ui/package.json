{
  "name": "nicevault-ui",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm -s i18n >/dev/null && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings=false",
    "test": "pnpm -s i18n >/dev/null && vitest run && node --test ../../scripts/release.test.mjs ../../extension/test/*.test.mjs",
    "mock-assets": "bash scripts/gen-mock-assets.sh",
    "shots": "node e2e/shots/shots.mjs",
    "tauri": "tauri",
    "e2e": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 playwright test",
    "e2e:setup": "bash e2e/setup-webkit.sh",
    "e2e:real": "bash e2e/real/e2e-real.sh",
    "e2e:real:tray": "NV_E2E_DBUS=1 NV_E2E_SCRIPT=tray.mjs bash e2e/real/e2e-real.sh",
    "e2e:real:flicker": "NV_E2E_SCRIPT=flicker.mjs bash e2e/real/e2e-real.sh",
    "e2e:real:media": "NV_E2E_SCRIPT=media-disk.mjs bash e2e/real/e2e-real.sh",
    "e2e:real:videos": "NV_E2E_SCRIPT=video-matrix.mjs bash e2e/real/e2e-real.sh",
    "e2e:real:window": "NV_E2E_SCRIPT=window.mjs bash e2e/real/e2e-real.sh",
    "e2e:real:markdown": "NV_E2E_SCRIPT=markdown.mjs bash e2e/real/e2e-real.sh",
    "e2e:real:browser": "NV_E2E_SCRIPT=browser-ext.mjs bash e2e/real/e2e-real.sh",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-it": "^4.1.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.28.0",
    "@inlang/plugin-message-format": "4.5.5",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
